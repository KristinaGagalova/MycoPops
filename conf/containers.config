/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process container overrides (Galaxy depot images)
    Overrides the containers declared inside the nf-core modules.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'BWAMEM2_INDEX' {
        container = 'https://depot.galaxyproject.org/singularity/bwa-mem2:2.2.1--he513fc3_0'
        publishDir = [
            path: { "${params.outdir}/bwamem_index" },
            mode: 'copy'
        ]
    }

    withName: 'BWAMEM2_MEM' {
        // bwa-mem2 + samtools mulled image (alignment piped to samtools sort)
        container = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113'
        publishDir = [
            path: { "${params.outdir}/bwamem_mapping" },
            mode: 'copy'
        ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        container = 'https://depot.galaxyproject.org/singularity/picard:3.4.0--hdfd78af_0'
        publishDir = [
            path: { "${params.outdir}/markdup" },
            mode: 'copy'
        ]
    }

    withName: 'COVERAGE_STATS' {
        container = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113'
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: 'copy'
        ]
    }

    withName: 'GENOME_COVERAGE' {
        container = 'community.wave.seqera.io/library/bwa-mem2_htslib_samtools:db98f81f55b64113'
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: 'copy',
            pattern: '*.tsv'
        ]
    }
 
    withName: 'SAMTOOLS_INDEX' {
        // Container comes from the nf-core module (samtools 1.23.1)
        publishDir = [
            path: { "${params.outdir}/markdup" },
            mode: 'copy',
            pattern: '*.bai'
        ]
    }

        withName: 'GATK4_HAPLOTYPECALLER' {
        // Container comes from the nf-core module (GATK 4.6.2.0, as in the original script)
        publishDir = [
            path: { "${params.outdir}/haplotypecaller" },
            mode: 'copy',
            pattern: '*.{vcf.gz,tbi}'
        ]
    }

    withName: 'GUNZIP|SAMTOOLS_FAIDX|GATK4_CREATESEQUENCEDICTIONARY' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: 'copy',
            pattern: '*.{fai,dict}'
        ]
    }

    withName: 'GATK4_COMBINEGVCFS|GATK4_INDEXFEATUREFILE|GATK4_GENOTYPEGVCFS' {
        // Containers come from the nf-core modules (GATK 4.6.2.0)
        publishDir = [
            path: { "${params.outdir}/genotyping" },
            mode: 'copy',
            pattern: '*.{vcf.gz,tbi}'
        ]
    }

    //
    // All GATK steps use the same GATK 4.6.2.0 container (the one the original WPM
    // scripts used on Setonix). The newer nf-core gatk4-main (4.7.0.0) image fails
    // under Singularity: its startup scripts run `R CMD javareconf`, which exceeds
    // Singularity's 1-minute limit.
    //
    withName: 'GATK4_CREATESEQUENCEDICTIONARY|GATK4_HAPLOTYPECALLER|GATK4_COMBINEGVCFS|GATK4_INDEXFEATUREFILE|GATK4_GENOTYPEGVCFS' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/gatk4:4.6.2.0--py310hdfd78af_1'
            : 'quay.io/biocontainers/gatk4:4.6.2.0--py310hdfd78af_1' }
    }

    withName: 'VARIANT_FILTRATION|SELECT_VARIANTS|FILTER_SNPS|ADD_VARIANT_IDS' {
        // Containers are declared in the modules (GATK 4.6.2.0 / bcftools 1.19)
        publishDir = [
            path: { "${params.outdir}/variant_filtering" },
            mode: 'copy',
            pattern: '*.{vcf.gz,tbi}'
        ]
    }

    withName: 'FASTP' {
        // Container comes from the nf-core module (fastp 1.1.0)
        // Reports only: the trimmed FASTQs are large and are passed straight to
        // the aligner. Add 'fastq.gz' to the pattern to keep them on disk too.
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: 'copy',
            pattern: '*.{html,json,log}'
        ]
    }

}

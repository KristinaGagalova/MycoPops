/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process parameters (ext.args) — matching the standalone alignment script
      - BWAMEM2_MEM        : -M  + read group
      - PICARD_MARKDUPLICATES : --TAGGING_POLICY All
      - GENOME_COVERAGE       : extra samtools depth filters (e.g. '-Q 20' min MAPQ)
      - GATK4_HAPLOTYPECALLER : -ERC GVCF -ploidy <params.ploidy>
      - GATK4_GENOTYPEGVCFS   : --max-alternate-alleles 4
      - VARIANT_FILTRATION    : the 7 hard-filter expressions; the genotype-rate
                                cutoff comes from --min_genotype_rate
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'BWAMEM2_MEM' {
	ext.args = { "-M -R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\"" }
    }

    withName: 'PICARD_MARKDUPLICATES' {
        // ext.prefix is required: input and output BAM would otherwise share a name
        ext.prefix = { "${meta.id}.markdup" }
        // TAGGING_POLICY=All from the script (GNU-style spelling for Picard 3.x module)
        ext.args   = '--TAGGING_POLICY All'
    }
    
     withName: 'GENOME_COVERAGE' {
        // Passed straight to `samtools depth -aa`. Empty = samtools defaults
        // (skips UNMAP, SECONDARY, QCFAIL, DUP). Example: '-Q 20' for min MAPQ 20.
        ext.args = ''
    }

    withName: 'GATK4_HAPLOTYPECALLER' {
        // Matches 6.GATK_HaplotypeCaller_array.sh
        ext.args   = { "-ERC GVCF -ploidy ${params.ploidy}" }
        ext.prefix = { "${meta.id}.g" }   // -> <sample>.g.vcf.gz
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        // Matches 7.GenotypeGVCF.sh
        ext.args   = '--max-alternate-alleles 4'
        ext.prefix = { "${meta.id}.genotyped" }   // -> cohort.genotyped.vcf.gz
    }

    withName: 'VARIANT_FILTRATION' {
        // Hard filters from 8.VariantFiltration.sh. Edit here to change them;
        // a variant is FLAGGED when its expression is TRUE.
        ext.args = [
            '--filter-name "QUAL450"        --filter-expression "QUAL < 450.0"',
            '--filter-name "QD20"           --filter-expression "QD < 20.0"',
            '--filter-name "MQ30"           --filter-expression "MQ < 30.0"',
            '--filter-name "FS0.1"          --filter-expression "FS > 0.1"',
            '--filter-name "BaseQRankSum"   --filter-expression "BaseQRankSum < -2.0 || BaseQRankSum > 2.0"',
            '--filter-name "MQRankSum"      --filter-expression "MQRankSum < -2.0 || MQRankSum > 2.0"',
            '--filter-name "ReadPosRankSum" --filter-expression "ReadPosRankSum < -2.0 || ReadPosRankSum > 2.0"'
        ].join(' ')

        // Extra SelectVariants options for the PASS step. Uncomment to keep SNPs
        // only (10.SelectVariantsSNP_INDELs.sh does this as a separate step):
        // ext.args2 = '--select-type-to-include SNP'
        ext.args2 = ''
    }

}

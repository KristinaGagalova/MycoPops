/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MycoPops Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params
params {
    // Input/output
    input           = null
    outdir          = './results'
    manifest_sep    = ','      // Use '\t' for TSV manifests

    // Reference genome
    fasta           = null
    bwamem2_index   = null     // Path to bwa-mem2 index directory
    genome_size     = null     // e.g. 139956545 for Bgt genome
    // Sample QC
    min_coverage    = 20       // Minimum mean depth (x) to keep a sample; 0 keeps all

    // Variant calling
    ploidy          = 1        // HaplotypeCaller -ploidy (1 = haploid fungi)

    // Max resource limits
    max_memory      = '128.GB'
    max_cpus        = 64
    max_time        = '24.h'
}

// Load configs
params.custom_config_base = "."
includeConfig("nfcore_custom.config")
includeConfig("conf/containers.config")
includeConfig("conf/modules.config")

process {
    withName: 'BWAMEM2_INDEX' {
        memory = '32.GB'
        cpus   = 4
        time   = '2h'
    }

    withName: 'BWAMEM2_MEM' {
        cpus   = 16
        memory = '32.GB'
        time   = '8h'
    }

    withName: 'PICARD_MARKDUPLICATES' {
        memory     = '32.GB'
    }

    withName: 'GATK4_HAPLOTYPECALLER' {
    // Original script: 2 CPUs, -Xmx4g, 12 h. The module sets -Xmx to 80% of memory.
    cpus   = 24
    memory = '24.GB'
    time   = '12h'
    }

    withName: 'GATK4_COMBINEGVCFS' {
        // Original CombineGVCFs.sh: 4 CPUs, 16 GB, 12 h. One job for the whole cohort,
        // so allow up to the 24 h limit of the Setonix work partition.
        cpus   = 24
        memory = '16.GB'
        time   = '24h'
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        // Original 7.GenotypeGVCF.sh: 8 CPUs, 64 GB (-Xmx48g), 3 days on the long partition.
        // The module sets -Xmx to 80% of memory (~51 GB).
        cpus   = 24
        memory = '64.GB'
        time   = '24h'
    }
}


// Container engine profiles
profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Workflow metadata
manifest {
    name            = 'MycoPop'
    author          = 'Dr Kristina Gagalova, Dr Grace Fang'
    homePage        = 'https://github.com/KristinaGagalova/MycoPops'
    description     = 'Fungal population genotyping and admixture analysis from WGS reads'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.0.1'
}

// Tracing / reporting
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
}
